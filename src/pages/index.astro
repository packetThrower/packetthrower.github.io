---
import Layout from '@packetthrower/site-theme/components/Layout.astro';
import InstallTabs from '@packetthrower/site-theme/components/InstallTabs.astro';
import { APPS, GITHUB, HUB, iconFor } from '@packetthrower/site-theme';

const description =
	'Open-source desktop tools for network engineers and tinkerers: Baudrun, PortFinder, etch341 and Zorite. macOS, Windows and Linux.';

// Latest release of each app, fetched at build time (deploy.yml rebuilds daily).
// A failed fetch drops that app's row and version badge rather than failing the build.
const headers = process.env.GITHUB_TOKEN ? { authorization: `Bearer ${process.env.GITHUB_TOKEN}` } : {};
/** First prose sentence, or the first bold bullet, of a release body. */
const summarize = (body = '') => {
	const block = body.replace(/\r/g, '').split(/\n\s*\n/).map((b) => b.trim()).find((b) => b && !b.startsWith('#')) ?? '';
	const bold = block.match(/^- \*\*(.+?)\*\*/);
	const text = bold ? bold[1] : block.replace(/\s+/g, ' ').split(/(?<=\.)\s/)[0];
	return text.replace(/\[([^\]]+)\]\([^)]*\)/g, '$1').replace(/[*`]/g, '').replace(/\.$/, '');
};
const releases = (
	await Promise.all(
		APPS.map(async (app) => {
			try {
				const res = await fetch(`https://api.github.com/repos/packetThrower/${app.repo}/releases/latest`, { headers });
				if (!res.ok) return null;
				const r = await res.json();
				return { app, version: r.tag_name.replace(/^v/, ''), date: r.published_at.slice(0, 10), url: r.html_url, summary: summarize(r.body) };
			} catch {
				return null;
			}
		}),
	)
)
	.filter((r) => r !== null)
	.sort((a, b) => b.date.localeCompare(a.date));
const versionOf = (app) => releases.find((r) => r.app === app)?.version;
const newest = releases[0];

const groups = [
	{ label: 'Network & hardware', apps: APPS.filter((a) => a.group === 'network') },
	{ label: 'Notes', apps: APPS.filter((a) => a.group === 'notes') },
];

const crates = [
	['zorite-editor', 'Multi-line Markdown editor for GPUI with live preview, tables, images and math.'],
	['zorite-markdown', 'Markdown reading view for GPUI: links, wiki-links, tables, alerts, right-to-left text.'],
	['gpui-pdf', 'PDF viewer for GPUI in pure Rust: text search, highlights, fillable forms.'],
	['gpui-whiteboard', 'Infinite whiteboard canvas: shapes, arrows, freehand drawing, text, images.'],
	['ratex-gpui', 'LaTeX rendering and a structural formula editor for GPUI.'],
	['gpui-bidi', 'Right-to-left and mixed-direction text: caret, selection, layout.'],
	['os-spellcheck', "Spell-checking through the operating system's own checker on macOS and Windows."],
	['os-cursors', 'Custom mouse cursors on macOS, Windows and Linux using XCursor themes.'],
];
---

<Layout
	title="packetThrower — tools for the people running the network"
	description={description}
	favicon="/icon.svg"
	ogImage={`${HUB}/og-image.png`}
>
	<Fragment slot="head">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
	</Fragment>

	<section class="pt-hero">
		<div class="pt-wrap pt-hero-grid">
			<div>
				{newest && (
					<a class="pt-pill" href={newest.url}><span class="pt-ver">new</span> {newest.app.name} {newest.version} is out: release notes →</a>
				)}
				<h1>Tools for the people <em>running the network.</em></h1>
				<p class="pt-lede">
					Four open-source desktop apps: a serial console, a switch-port finder, a flash programmer, and a journal to
					write it all down. Native Rust, GPU-rendered, one download on macOS, Windows and Linux.
				</p>
				<div class="pt-actions">
					<a class="pt-btn pt-btn-primary" href="#apps">Browse the apps</a>
					<a class="pt-btn" href="#install">Install with your package manager</a>
				</div>
			</div>
			<div class="pt-term" aria-label="Example: installing every app with Homebrew, then running PortFinder">
				<div class="pt-term-bar"><i></i><i></i><i></i><span>zsh — field laptop</span></div>
				<pre><span class="t-p">$</span> brew tap packetThrower/tap
<span class="t-p">$</span> brew trust packetThrower/tap
<span class="t-p">$</span> brew install --cask baudrun portfinder etch341 zorite
{APPS.map((a) => <Fragment><span class="t-ok">==&gt;</span> Installing Cask <b>{a.id}</b> <span class="t-dim">{versionOf(a) ?? ''}</span>{'\n'}</Fragment>)}<span class="t-p">$</span> portfinder --cli en7
<span class="t-dim">listening for CDP / LLDP / MNDP…</span>
  switch   <span class="t-if">core-sw-01</span>  <span class="t-ip">10.20.0.2</span>
  port     <span class="t-if">GigabitEthernet1/0/24</span>
  vlan     <span class="t-ok">120</span> <span class="t-dim">(voice 130)</span></pre>
			</div>
		</div>
	</section>

	<section id="apps" class="pt-section">
		<div class="pt-wrap">
			<div class="pt-head">
				<div><div class="pt-eyebrow">The apps</div><h2>Built for the rack, the bench and the notebook.</h2></div>
			</div>
			{groups.map((g) => (
				<Fragment>
					<div class="pt-group">{g.label}</div>
					<div class="pt-apps">
						{g.apps.map((a) => (
							<article class="pt-app-card">
								<a class:list={['pt-card-shot', { contain: a.contain }]} href={a.base}>
									<img src={`${a.base}${a.screenshot}`} alt={`${a.name} screenshot`} loading="lazy" />
								</a>
								<div class="pt-card-body">
									<header>
										<img src={iconFor(a)} alt="" width="44" height="44" />
										<div><h3>{a.name}</h3><div class="pt-kind">{a.kind}</div></div>
										{versionOf(a) && <span class="pt-ver">v{versionOf(a)}</span>}
									</header>
									<p>{a.summary}</p>
									<div class="pt-chips">{a.chips.map((c) => <span class="pt-chip">{c}</span>)}</div>
									<div class="pt-card-links">
										<a href={a.base}>Overview</a>
										<a href={`${a.base}${a.docsStart}`}>Docs</a>
										<a href={`${GITHUB}/${a.repo}`}>GitHub ↗</a>
									</div>
								</div>
							</article>
						))}
						{g.label === 'Notes' && (
							<div class="pt-app-card" style="justify-content:center;padding:28px;background:var(--pt-bg-2)">
								<div class="pt-eyebrow">Shared foundation</div>
								<h3 style="margin:10px 0 8px;font-size:20px">One stack, four apps</h3>
								<p style="margin:0;color:var(--pt-ink-2)">
									Every app is Rust on GPUI and GPUI Kit, ships as a single native binary, and installs the same way: Homebrew,
									Scoop, winget, or a <code>.deb</code>, <code>.rpm</code> or AppImage.
								</p>
								<div class="pt-card-links" style="margin-top:18px"><a href="#libraries">Libraries we publish →</a></div>
							</div>
						)}
					</div>
				</Fragment>
			))}
		</div>
	</section>

	<section id="install" class="pt-section pt-band">
		<div class="pt-wrap pt-split">
			<div>
				<div class="pt-eyebrow">Install</div>
				<h2>One tap, one bucket, every app.</h2>
				<p>
					Package managers keep the apps updated and skip the Gatekeeper and SmartScreen prompts. Each app also has a
					pre-release channel that installs side by side with stable.
				</p>
				<ul class="pt-checks">
					<li>Homebrew tap and Scoop bucket carry stable and pre-release</li>
					<li>winget for stable releases (Baudrun, PortFinder, Zorite)</li>
					<li>Linux: <code>.deb</code>, <code>.rpm</code>, AppImage and Arch packages on each release</li>
				</ul>
			</div>
			<InstallTabs
				id="hub"
				panels={[
					{
						os: 'mac',
						cmds: ['brew tap packetThrower/tap', 'brew trust packetThrower/tap', 'brew install --cask baudrun portfinder etch341 zorite'],
						note: 'Pre-release: append <code>@alpha</code>, e.g. <code>baudrun@alpha</code>.',
					},
					{
						os: 'win',
						cmds: [
							'scoop bucket add packetThrower https://github.com/packetThrower/scoop-bucket',
							'scoop install baudrun portfinder etch341 zorite',
							'winget install packetThrower.Baudrun',
						],
						note: 'Pre-release on Scoop: <code>baudrun-prerelease</code>. etch341 is not on winget.',
					},
					{
						os: 'linux',
						cmds: ['nix run github:packetThrower/zorite'],
						note: 'Packages for every app are attached to its GitHub release, with <code>SHA256SUMS</code>. Each app\'s Install page has the details.',
					},
				]}
			/>
		</div>
	</section>

	{releases.length > 0 && (
		<section id="releases" class="pt-section">
			<div class="pt-wrap">
				<div class="pt-head">
					<div><div class="pt-eyebrow">Releases</div><h2>Latest from each app</h2></div>
					<a class="pt-link" href={GITHUB}>All repositories on GitHub →</a>
				</div>
				<div class="pt-rows">
					{releases.map((r) => (
						<a class="pt-row" href={r.url}>
							<img src={iconFor(r.app)} alt="" width="28" height="28" />
							<div><b>{r.app.name} {r.version}</b> <span class="pt-muted" style="font-size:14px">— {r.summary}</span></div>
							<time datetime={r.date}>{r.date}</time>
						</a>
					))}
				</div>
			</div>
		</section>
	)}

	<section id="libraries" class="pt-section pt-band">
		<div class="pt-wrap">
			<div class="pt-head">
				<div>
					<div class="pt-eyebrow">Libraries</div>
					<h2>Crates we publish along the way</h2>
					<p>Pieces of the apps, released on their own. Each has an overview and a full API reference.</p>
				</div>
			</div>
			<div class="pt-libs">
				{crates.map(([name, text]) => (
					<a class="pt-lib" href={`/zorite/reference/crates/${name}/`}><em>Rust</em><strong>{name}</strong><span>{text}</span></a>
				))}
				<a class="pt-lib" href={`${GITHUB}/usbserial-go`}><em>Go</em><strong>usbserial-go</strong><span>USB-to-serial adapters over libusb, speaking each chipset's own protocol.</span></a>
			</div>
		</div>
	</section>
</Layout>
